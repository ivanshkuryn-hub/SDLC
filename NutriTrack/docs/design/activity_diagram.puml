@startuml

title Activity Diagram — Общая динамика работы NutriTrack

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam activity {
    BackgroundColor #F2F2F2
    BorderColor #555555
    DiamondBackgroundColor #FFF2CC
    DiamondBorderColor #A58B35
}

' Две области ответственности: пользователь и приложение
|Пользователь|
start
:Запускает приложение NutriTrack;

|Система NutriTrack|
:Отображает главную страницу
и дневную сводку;

while (Пользователь продолжает работу?) is (Да)

    |Пользователь|
    :Выбирает раздел приложения;

    switch (Выбранный раздел?)

    case (Дневник питания)

        |Система NutriTrack|
        :Отображает дневник питания
        за выбранную дату;

        |Пользователь|
        switch (Действие с дневником?)

        case (Просмотр)
            |Пользователь|
            :Выбирает дату дневника;
            |Система NutriTrack|
            :Отображает записи и дневные итоги;

        case (Добавление продукта)
            |Пользователь|
            :Выбирает ручной ввод
            или поиск продукта по штрих-коду;

            if (Поиск по штрих-коду?) then (Да)
                :Загружает фотографию штрих-кода;
                |Система NutriTrack|
                :Выполняет поиск продукта
                в локальной базе;

                if (Продукт найден?) then (Да)
                    :Отображает карточку продукта;
                    |Пользователь|
                    :Указывает массу порции;
                else (Нет)
                    :Предлагает перейти к ручному вводу;
                    |Пользователь|
                    :Вводит название, массу порции
                    и пищевую ценность на 100 г;
                endif
            else (Ручной ввод)
                :Вводит название, массу порции
                и пищевую ценность на 100 г;
            endif

            |Система NutriTrack|
            :Проверяет данные и рассчитывает КБЖУ;
            if (Данные корректны?) then (Да)
                :Сохраняет запись в дневнике;
                :Обновляет дневные итоги;
            else (Нет)
                :Отображает сообщение об ошибке;
            endif

        case (Удаление записи)
            |Пользователь|
            :Выбирает запись и подтверждает удаление;
            |Система NutriTrack|
            :Удаляет запись и пересчитывает дневные итоги;

        case (Экспорт PDF)
            |Пользователь|
            :Запускает экспорт дневника за дату;
            |Система NutriTrack|
            :Формирует PDF-отчёт;
            :Передаёт файл браузеру;

        endswitch

    case (Учёт воды)

        |Система NutriTrack|
        :Отображает дневной объём воды
        и установленную цель;

        |Пользователь|
        if (Способ добавления воды?) then (Быстрое добавление)
            :Выбирает 250 мл или 500 мл;
        else (Ручной ввод)
            :Вводит объём воды;
        endif

        |Система NutriTrack|
        :Проверяет и сохраняет запись;
        :Обновляет дневной объём
        и прогресс относительно цели;

        |Пользователь|
        if (Изменить цель по воде?) then (Да)
            :Вводит новое значение цели;
            |Система NutriTrack|
            :Сохраняет цель и обновляет прогресс;
        endif

    case (Главная страница)

        |Система NutriTrack|
        :Отображает сводку, графики калорий,
        воды и массы тела;

        |Пользователь|
        if (Добавить измерение веса?) then (Да)
            :Вводит массу тела и дату измерения;
            |Система NutriTrack|
            :Проверяет и сохраняет измерение;
            :Обновляет график изменения веса;
        endif

        |Пользователь|
        if (Изменить цель по калориям?) then (Да)
            :Вводит новое значение цели;
            |Система NutriTrack|
            :Сохраняет цель и обновляет прогресс;
        endif

    case (Настройка темы)

        |Пользователь|
        :Выбирает светлую или тёмную тему;
        |Система NutriTrack|
        :Применяет тему ко всем основным экранам;
        :Сохраняет выбранную тему;

    endswitch

    |Система NutriTrack|
    :Обновляет отображаемую информацию;

endwhile (Нет)

|Система NutriTrack|
:Завершает работу приложения;
stop

@enduml
